---
interface Props {
  yearKey: string;     // "2025" | "2024" | ... | "archive"
  count?: number;      // optional item count to show
}

const { yearKey, count } = Astro.props;
const isArchive = yearKey === 'archive';
const label = isArchive ? 'Archive' : yearKey;
const sublabel = isArchive ? '〜2022' : '年';
---

<h2 class="flex items-baseline gap-3 mb-6">
  <span class="self-center w-1.5 h-1.5 rounded-full bg-[var(--accent)]"></span>
  <span class="text-3xl font-medium tracking-tight text-ink tabular-nums">{label}</span>
  <span class="text-sm text-ink-muted">{sublabel}</span>
  {count !== undefined && (
    <span class="text-xs text-ink-faint" data-year-count>{count}件</span>
  )}
  <span class="flex-1 h-px bg-[linear-gradient(to_right,var(--border-soft),transparent)]"></span>
</h2>
