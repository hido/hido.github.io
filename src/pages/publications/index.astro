---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PublicationItem from '../../components/PublicationItem.astro';
import PageHeading from '../../components/PageHeading.astro';
import YearHeading from '../../components/YearHeading.astro';
import { groupByYear } from '../../utils/group-by-year';
import { publicationTag, type PublicationTag } from '../../utils/publication-tag';

const all = await getCollection('publications');
const sorted = all.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

type Tagged = (typeof sorted)[number] & { tag: PublicationTag };
const tagged: Tagged[] = sorted.map((p) => ({ ...p, tag: publicationTag(p.data.venue) }));

const { grouped, orderedKeys } = groupByYear(tagged, (p) => p.data.date);

const allTags: PublicationTag[] = ['論文', 'パテント'];
const tagCounts = Object.fromEntries(
  allTags.map((t) => [t, tagged.filter((p) => p.tag === t).length]),
) as Record<PublicationTag, number>;
---

<BaseLayout title="論文 — 比戸 将平">
  <PageHeading title="論文" en="Publications" description="論文誌・国際会議発表・特許など。" />

  <div class="flex flex-wrap gap-2 mb-8" role="group" aria-label="種別でフィルタ" id="pub-filter">
    {allTags.map((t) => (
      <button
        type="button"
        data-filter={t}
        class={`filter-btn ${t === '論文' ? 'is-active' : ''} px-3 py-1 text-xs rounded-full border border-border-soft text-ink-secondary hover:border-border-strong transition-colors`}
      >
        {t} <span class="text-ink-faint ml-1">{tagCounts[t]}</span>
      </button>
    ))}
    <button
      type="button"
      data-filter="all"
      class="filter-btn px-3 py-1 text-xs rounded-full border border-border-soft text-ink-secondary hover:border-border-strong transition-colors"
    >
      すべて <span class="text-ink-faint ml-1">{tagged.length}</span>
    </button>
  </div>

  {orderedKeys.map((key) => (
    <section class="mb-10" data-year-section={key}>
      <YearHeading yearKey={key} count={grouped.get(key)!.length} />
      <ul>
        {grouped.get(key)!.map((p) => (
          <PublicationItem
            title={p.data.title}
            date={p.data.date}
            venue={p.data.venue}
            authors={p.data.authors}
            tag={p.tag}
            thumbnail={p.data.thumbnail}
            links={p.data.links}
          />
        ))}
      </ul>
    </section>
  ))}
</BaseLayout>

<style>
  .filter-btn.is-active {
    background-color: var(--accent);
    color: var(--bg-canvas);
    border-color: var(--accent);
  }
  .filter-btn.is-active span {
    color: color-mix(in oklab, var(--bg-canvas) 60%, transparent);
  }
</style>

<script>
  import { setupFilterUI } from '../../utils/filter-ui';

  setupFilterUI({
    filterRootSelector: '#pub-filter',
    itemSelector: 'li[data-tag]',
    paramName: 'type',
    defaultFilter: '論文',
  });
</script>
