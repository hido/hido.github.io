---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import TalkCard from '../../components/TalkCard.astro';
import PageHeading from '../../components/PageHeading.astro';
import YearHeading from '../../components/YearHeading.astro';
import { mergeContentItems } from '../../utils/content-items';
import { groupByYear } from '../../utils/group-by-year';

const [talks, press, awards] = await Promise.all([
  getCollection('talks'),
  getCollection('press'),
  getCollection('awards'),
]);

const items = mergeContentItems(talks, press, awards);
const { grouped, orderedKeys } = groupByYear(items, (it) => it.date);

// Distinct tags for filter UI; keep stable order with talks first.
const allTags = Array.from(new Set(items.map((it) => it.tag)));
// Upcoming items get their own filter pill alongside the regular tags;
// they're still tagged 講演 / メディア / 表彰 so this is a cross-cutting filter.
const upcomingCount = items.filter((it) => it.isUpcoming).length;
---

<BaseLayout title="講演・メディア掲載 — 比戸 将平">
  <PageHeading title="講演・メディア掲載" en="Talks & Media" description="登壇イベントと、新聞・専門メディアによる記事・インタビュー。" />

  <div class="flex flex-wrap gap-2 mb-8" role="group" aria-label="タグでフィルタ" id="tag-filter">
    <button
      type="button"
      data-filter="all"
      class="filter-btn is-active px-3 py-1 text-xs rounded-full border border-border-soft text-ink-secondary hover:border-border-strong transition-colors"
    >
      すべて <span class="text-ink-faint ml-1" data-count="all">{items.length}</span>
    </button>
    {allTags.map((t) => (
      <button
        type="button"
        data-filter={t}
        class="filter-btn px-3 py-1 text-xs rounded-full border border-border-soft text-ink-secondary hover:border-border-strong transition-colors"
      >
        {t} <span class="text-ink-faint ml-1" data-count={t}>{items.filter((it) => it.tag === t).length}</span>
      </button>
    ))}
    {upcomingCount > 0 && (
      <button
        type="button"
        data-filter="upcoming"
        class="filter-btn px-3 py-1 text-xs rounded-full border border-indigo-300 text-indigo-700 hover:border-indigo-500 dark:border-indigo-500/60 dark:text-indigo-300 dark:hover:border-indigo-400 transition-colors"
      >
        予定 <span class="text-indigo-300 dark:text-indigo-400/70 ml-1" data-count="upcoming">{upcomingCount}</span>
      </button>
    )}
  </div>

  {orderedKeys.map((key) => (
    <section class="mb-12" data-year-section={key}>
      <YearHeading yearKey={key} count={grouped.get(key)!.length} />
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-4">
        {grouped.get(key)!.map((it) => (
          <TalkCard
            title={it.title}
            date={it.date}
            event={it.subtitle}
            eventDetail={it.subtitleDetail}
            tag={it.tag}
            isUpcoming={it.isUpcoming}
            links={it.links}
            thumbnail={it.thumbnail}
            copyright={it.copyright}
          />
        ))}
      </div>
    </section>
  ))}
</BaseLayout>

<style>
  .filter-btn.is-active {
    background-color: var(--accent);
    color: var(--bg-canvas);
    border-color: var(--accent);
  }
  .filter-btn.is-active span[data-count] {
    color: color-mix(in oklab, var(--bg-canvas) 60%, transparent);
  }
  .filter-btn:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
</style>

<script>
  import { setupFilterUI } from '../../utils/filter-ui';

  // "upcoming" is a virtual filter that crosses the regular 講演 / メディア /
  // 表彰 tag axis, so we extend the default tag-equality match.
  setupFilterUI({
    filterRootSelector: '#tag-filter',
    itemSelector: 'article[data-tag]',
    paramName: 'tag',
    defaultFilter: 'all',
    match: (item, filter) => {
      if (filter === 'all') return true;
      if (filter === 'upcoming') return item.dataset.upcoming === 'true';
      return (item.dataset.tag ?? '') === filter;
    },
  });
</script>
