---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeading from '../../components/PageHeading.astro';
import BlogCard from '../../components/BlogCard.astro';
import YearHeading from '../../components/YearHeading.astro';
import { publishedBlogPosts, blogExcerpt, coverUrl } from '../../utils/blog';
import { groupByYear } from '../../utils/group-by-year';

// Posts live on note; this page only lists them. See src/content.config.ts.
const posts = await publishedBlogPosts();
const { grouped, orderedKeys } = groupByYear(posts, (p) => p.data.date);
---

<BaseLayout title="Blog — 比戸 将平">
  <PageHeading
    title="Blog"
    en="Notes & posts"
    description="note に書いた記事の一覧です。"
  />

  <div class="flex gap-4 mb-8">
    <a href="https://note.com/shoheihido" target="_blank" rel="noopener" class="text-sm border border-border-soft text-ink-secondary rounded px-3 py-1.5 hover:border-accent hover:text-accent">
      note を見る →
    </a>
    <a href="https://twitter.com/sla" target="_blank" rel="noopener" class="text-sm border border-border-soft text-ink-secondary rounded px-3 py-1.5 hover:border-accent hover:text-accent">
      X / Twitter を見る →
    </a>
  </div>

  {posts.length === 0 ? (
    <p class="text-ink-faint text-sm">準備中です。</p>
  ) : (
    orderedKeys.map((key) => (
      <section class="mb-12">
        <YearHeading yearKey={key} count={grouped.get(key)!.length} />
        <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-5">
          {grouped.get(key)!.map((p) => (
            <BlogCard
              title={p.data.title}
              date={p.data.date}
              excerpt={blogExcerpt(p)}
              note={p.data.note!}
              x={p.data.x}
              thumbnail={coverUrl(p, 'card')}
            />
          ))}
        </div>
      </section>
    ))
  )}
</BaseLayout>
