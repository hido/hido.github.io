---
import '../styles/global.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { THEME_INIT, GTAG_INIT } from '../security/inline-scripts.mjs';

interface Props {
  title?: string;
  description?: string;
  width?: 'narrow' | 'wide';
  ogImage?: string;     // override the default per-path picker
}

const {
  title = '比戸 将平 — Shohei Hido',
  description = 'Shohei Hido — ダイキン工業 テクノロジー・イノベーションセンター 技師長',
  width = 'wide',
  ogImage,
} = Astro.props;

const mainClass =
  width === 'wide'
    ? 'max-w-6xl mx-auto px-6 py-10'
    : 'max-w-3xl mx-auto px-6 py-10';

// Pick a per-path OG image; fall back to default. Pre-generated by
// scripts/generate-og.mjs into public/og/*.png.
function pickOgImage(pathname: string): string {
  const p = pathname.replace(/\/$/, '');
  if (p === '' || p === '/') return '/og/default.png';
  if (p.startsWith('/talks-and-media')) return '/og/talks-and-media.png';
  if (p.startsWith('/publications')) return '/og/publications.png';
  if (p.startsWith('/blog')) return '/og/blog.png';
  return '/og/default.png';
}

const ogPath = ogImage ?? pickOgImage(Astro.url.pathname);
const ogImageAbsolute = new URL(ogPath, Astro.site ?? 'https://hido.github.io').href;
const canonical = new URL(Astro.url.pathname, Astro.site ?? 'https://hido.github.io').href;
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    {/* CSP is injected at build time by Astro (experimental.csp in
        astro.config.mjs) with sha256 hashes instead of 'unsafe-inline'.
        GitHub Pages can't set HTTP headers, hence meta delivery. */}
    {/* Permissions-Policy: deny every powerful feature the site doesn't use.
        Defense-in-depth against future regressions (e.g. an embedded widget
        that asks for camera/mic). Empty allowlist = blocked entirely. */}
    <meta
      http-equiv="Permissions-Policy"
      content="accelerometer=(), autoplay=(), camera=(), cross-origin-isolated=(), display-capture=(), encrypted-media=(), fullscreen=(self), geolocation=(), gyroscope=(), keyboard-map=(), magnetometer=(), microphone=(), midi=(), payment=(), picture-in-picture=(), publickey-credentials-get=(), screen-wake-lock=(), sync-xhr=(), usb=(), web-share=(), xr-spatial-tracking=(), interest-cohort=(), browsing-topics=()"
    />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <meta http-equiv="X-Content-Type-Options" content="nosniff" />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageAbsolute} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageAbsolute} />

    <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'%3E%3Ctext y='.9em' font-size='90'%3E🌅%3C/text%3E%3C/svg%3E" />
    <link rel="alternate" type="application/rss+xml" title="比戸 将平 — Shohei Hido" href="/rss.xml" />
    <title>{title}</title>

    <!-- Inline script bodies live in src/security/inline-scripts.mjs so the
         CSP hashes registered in astro.config.mjs always match what renders
         here. Theme init must stay inline in <head> to avoid a FOUC. -->
    <script is:inline set:html={THEME_INIT} />

    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-VFWBCZCM1D"></script>
    <script is:inline set:html={GTAG_INIT} />
  </head>
  <body class="text-ink bg-canvas">
    <SiteHeader />
    <main class={mainClass}>
      <slot />
    </main>
    <SiteFooter />
  </body>
</html>
